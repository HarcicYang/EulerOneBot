{
  "$defs": {
    "EventCompatibilityConfig": {
      "properties": {
        "reaction_event_type": {
          "default": "reaction",
          "enum": [
            "reaction",
            "group_msg_emoji_like"
          ],
          "title": "Reaction Event Type",
          "type": "string"
        }
      },
      "title": "EventCompatibilityConfig",
      "type": "object"
    },
    "ForwardWebsocketConfig": {
      "properties": {
        "type": {
          "const": "ForwardWebSocket",
          "default": "ForwardWebSocket",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "ForwardWebsocketConfig",
      "type": "object"
    },
    "HTTPConfig": {
      "properties": {
        "type": {
          "const": "HTTP",
          "default": "HTTP",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "HTTPConfig",
      "type": "object"
    },
    "HTTPPostConfig": {
      "properties": {
        "type": {
          "const": "HTTPPost",
          "default": "HTTPPost",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "timeout": {
          "default": 0,
          "title": "Timeout",
          "type": "integer"
        },
        "secret": {
          "default": "",
          "title": "Secret",
          "type": "string"
        }
      },
      "title": "HTTPPostConfig",
      "type": "object"
    },
    "HeartbeatConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "interval": {
          "default": 15000,
          "description": "心跳间隔(毫秒),必须大于 0",
          "exclusiveMinimum": 0,
          "title": "Interval",
          "type": "integer"
        }
      },
      "title": "HeartbeatConfig",
      "type": "object"
    },
    "LoginConfig": {
      "properties": {
        "uin": {
          "default": 0,
          "title": "Uin",
          "type": "integer"
        },
        "signer_url": {
          "default": "https://",
          "title": "Signer Url",
          "type": "string"
        },
        "signer_token": {
          "default": "",
          "title": "Signer Token",
          "type": "string"
        },
        "use_custom": {
          "default": false,
          "title": "Use Custom",
          "type": "boolean"
        },
        "appinfo_path": {
          "default": "./appinfo.json",
          "title": "Appinfo Path",
          "type": "string"
        },
        "use_custom_sign_provider": {
          "default": false,
          "title": "Use Custom Sign Provider",
          "type": "boolean"
        },
        "sign_provider_path": {
          "default": "./sign_provider.py",
          "title": "Sign Provider Path",
          "type": "string"
        },
        "sign_provider_entry": {
          "default": "sign_provider",
          "title": "Sign Provider Entry",
          "type": "string"
        },
        "setup_watchdog": {
          "default": false,
          "title": "Setup Watchdog",
          "type": "boolean"
        },
        "use_ipv6": {
          "default": false,
          "title": "Use Ipv6",
          "type": "boolean"
        },
        "use_optimum": {
          "default": true,
          "title": "Use Optimum",
          "type": "boolean"
        }
      },
      "title": "LoginConfig",
      "type": "object"
    },
    "ReverseWebsocketConfig": {
      "properties": {
        "type": {
          "const": "ReverseWebSocket",
          "default": "ReverseWebSocket",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "api_url": {
          "default": "",
          "title": "Api Url",
          "type": "string"
        },
        "event_url": {
          "default": "",
          "title": "Event Url",
          "type": "string"
        },
        "use_universal_client": {
          "default": false,
          "title": "Use Universal Client",
          "type": "boolean"
        },
        "reconnect_interval": {
          "default": 3000,
          "title": "Reconnect Interval",
          "type": "integer"
        }
      },
      "title": "ReverseWebsocketConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "log_level": {
      "default": "INFO",
      "enum": [
        "INFO",
        "DEBUG",
        "TRACE",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "Log Level",
      "type": "string"
    },
    "log_nf": {
      "default": true,
      "title": "Log Nf",
      "type": "boolean"
    },
    "access_token": {
      "default": "",
      "title": "Access Token",
      "type": "string"
    },
    "connections": {
      "default": [
        {
          "type": "ForwardWebSocket",
          "url": ""
        }
      ],
      "items": {
        "discriminator": {
          "mapping": {
            "ForwardWebSocket": "#/$defs/ForwardWebsocketConfig",
            "HTTP": "#/$defs/HTTPConfig",
            "HTTPPost": "#/$defs/HTTPPostConfig",
            "ReverseWebSocket": "#/$defs/ReverseWebsocketConfig"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HTTPConfig"
          },
          {
            "$ref": "#/$defs/HTTPPostConfig"
          },
          {
            "$ref": "#/$defs/ForwardWebsocketConfig"
          },
          {
            "$ref": "#/$defs/ReverseWebsocketConfig"
          }
        ]
      },
      "title": "Connections",
      "type": "array"
    },
    "login": {
      "$ref": "#/$defs/LoginConfig",
      "default": {
        "uin": 0,
        "signer_url": "https://",
        "signer_token": "",
        "use_custom": false,
        "appinfo_path": "./appinfo.json",
        "use_custom_sign_provider": false,
        "sign_provider_path": "./sign_provider.py",
        "sign_provider_entry": "sign_provider",
        "setup_watchdog": false,
        "use_ipv6": false,
        "use_optimum": true
      }
    },
    "heartbeat": {
      "$ref": "#/$defs/HeartbeatConfig",
      "default": {
        "enabled": true,
        "interval": 15000
      }
    },
    "event_compatibility": {
      "$ref": "#/$defs/EventCompatibilityConfig",
      "default": {
        "reaction_event_type": "reaction"
      }
    },
    "$schema": {
      "type": "string",
      "description": "JSON Schema 引用,解析时忽略"
    }
  },
  "title": "BotConfig",
  "type": "object",
  "description": "Euler OneBot 的 appconfig.json 配置结构,由 BotConfig 模型自动生成",
  "$id": "./appconfig.schema.json"
}
